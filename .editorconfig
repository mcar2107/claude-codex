# editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
charset = utf-8
indent_size = 2

[{*.js,*.cjs,*.mjs,*.ts}]
trim_trailing_whitespace = true

# Исходники upstream байт в байт: хеши сверяет vendor/ccr/original-sha256.json.
[vendor/**]
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
charset = unset
trim_trailing_whitespace = unset
