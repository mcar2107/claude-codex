{
  /**
   * Проверка типов и typed-lint всего TypeScript проекта. Код vendor/ccr попадает в проверку
   * транзитивно — через импорты адаптера, — поэтому алиасы повторяют подмены scripts/build.ts:
   * `@/…` → vendor/ccr/core/src, `@caeliq/ccr-shared` → адаптер.
   */
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/transformer": ["./src/transport/registry.ts"],
      "@/*": ["./vendor/ccr/core/src/*"],
      "@caeliq/ccr-shared": ["./src/transport/shared.ts"]
    }
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    ".claude/hooks/*.ts"
  ]
}
