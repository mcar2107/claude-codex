{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/cli.ts",
    "scripts/*.ts",
    /**
     * PostToolUse-хук Claude Code: его запускает `.claude/settings.json`.
     */
    ".claude/hooks/lint.ts",
    "tests/offline.ts",
    /**
     * Адаптер для vendor/ccr: эти файлы подставляет плагин scripts/build.ts вместо модулей upstream
     * (`@/transformer`, `@caeliq/ccr-shared`, `tiktoken`, воркер подсчёта токенов). Их импортирует
     * код vendor, который Knip не разбирает, поэтому они — точки входа.
     */
    "src/transport/registry.ts",
    "src/transport/shared.ts",
    "src/transport/token-count.ts",
    "src/transport/tiktoken.ts",
    /**
     * Объявления виртуальных модулей `tiktoken-*` для tsc: их не импортируют, их видит компилятор.
     */
    "src/transport/tiktoken.types.ts",
  ],
  "project": [
    "*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    ".claude/hooks/*.ts",
  ],
  "ignoreDependencies": [
    /**
     * Зависимости исходников vendor/ccr: в бандл их тянет код upstream, который Knip не разбирает.
     * `openai` и `@anthropic-ai/sdk` — только типы для `bun run typecheck`.
     */
    "@fastify/cors",
    "@fastify/rate-limit",
    "@huggingface/tokenizers",
    "dotenv",
    "fastify-plugin",
    "json5",
    "jsonrepair",
    "latex-to-unicode",
    "lru-cache",
    "uuid",
    "openai",
    "@anthropic-ai/sdk",
    /**
     * Зовётся из .husky/pre-commit через `bunx`.
     */
    "lint-staged",
    /**
     * Виртуальные модули: их отдаёт плагин scripts/build.ts из файлов пакета tiktoken, пакета нет.
     */
    "tiktoken-bindings",
    "tiktoken-wasm",
  ],
  "ignoreBinaries": [
    /**
     * Бинарные инструменты проверок ставит mise по .mise.toml, а не npm.
     */
    "mise",
  ],
}
