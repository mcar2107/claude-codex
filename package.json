{
  "name": "claude-codex",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Claude Code to Codex OAuth bridge with isolated sessions and live model settings",
  "license": "UNLICENSED",
  "bin": {
    "claude-codex": "dist/cli.cjs"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "dist/cli.cjs",
    "dist/cli.cjs.LEGAL.txt",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor/ccr/LICENSE",
    "vendor/ccr/PROVENANCE.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "bun scripts/build.cjs",
    "build:standalone": "bun scripts/standalone.cjs",
    "test": "bun scripts/test.cjs",
    "test:legacy": "node verify.cjs && bun verify-transport.cjs",
    "test:package": "bun scripts/test-package.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "concurrently --kill-others-on-fail \"npm:lint:es\" \"npm:typecheck\" \"npm:lint:format\" \"npm:lint:knip\" \"npm:lint:sg\" \"npm:lint:agents\"",
    "lint:es": "eslint . --cache --cache-strategy=content",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --check .",
    "lint:knip": "knip --no-progress",
    "lint:sg": "mise x -- ast-grep scan && mise x -- ast-grep test",
    "lint:agents": "mise x -- agnix --strict .",
    "lint:secrets": "mise x -- betterleaks git . --redact -v --no-banner",
    "lint:deps": "mise x -- osv-scanner scan source --config=osv-scanner.toml -L package-lock.json",
    "format": "prettier --write .",
    "prepack": "bun scripts/build.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@caeliq/claude-code-router": "2.1.16",
    "@eslint/js": "10.0.1",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@huggingface/tokenizers": "0.1.3",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "json5": "2.2.3",
    "jsonrepair": "3.15.0",
    "knip": "6.43.0",
    "latex-to-unicode": "0.1.0",
    "lint-staged": "17.6.0",
    "lru-cache": "11.5.3",
    "openai": "7.49.0",
    "prettier": "3.9.10",
    "tiktoken": "1.0.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "uuid": "14.0.3"
  }
}
